<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet" />
<style>
  :root{
    /* Cores personalizadas */
    --bg:#101418; --accent:#c7009c;
    --text:#ffffff; --soft:#E1E1E1;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  body{background:#000;font-family:'Inter',sans-serif;}
  .slide{position:relative;width:1080px;height:1350px;overflow:hidden;display:flex;
    flex-direction:column;padding:88px 84px 76px;background:var(--bg);color:var(--text);}

  /* imagem-herói + escurecimento */
  .hero{position:absolute;inset:0;z-index:0;background-size:cover;background-position:center;
    background-color:var(--bg);}
  .hero--capa{background-image:url('img/capa.png');}
  .scrim{position:absolute;inset:0;z-index:1;pointer-events:none;
    background:linear-gradient(180deg,
      rgba(16,20,24,0.85) 0%, rgba(16,20,24,0.50) 30%,
      rgba(16,20,24,0.55) 60%, rgba(16,20,24,0.95) 100%);}

  /* corpo do slide */
  .body{position:relative;z-index:3;flex:1;display:flex;flex-direction:column;justify-content:center;}

  /* Aspas tipográficas */
  .aspas{position:absolute;z-index:2;font-family:'Poppins',sans-serif;font-weight:800;
    color:var(--accent);opacity:0.15;line-height:0.7;pointer-events:none;user-select:none;}
  .aspas--abre{top:96px;left:70px;font-size:360px;}
  .aspas--fecha{bottom:150px;right:70px;font-size:360px;}

  /* Declaração */
  .declaracao{font-family:'Poppins',sans-serif;font-weight:800;text-transform:uppercase;
    font-size:104px;line-height:1.02;letter-spacing:-0.02em;text-wrap:balance;}
  .slide .sub{margin-top:40px;font-size:36px;font-weight:500;line-height:1.4;color:var(--soft);max-width:900px;}

  /* palavra(s) no destaque */
  .accent{color:var(--accent);}

  /* rodapé: @ + "arraste" */
  .foot{position:relative;z-index:3;display:flex;align-items:center;justify-content:space-between;
    margin-top:40px;font-size:25px;font-weight:600;color:var(--soft);}
  .foot .swipe{display:flex;align-items:center;gap:12px;font-weight:700;color:var(--accent);}
</style>
</head>
<body>

<div class="slide capa">
  <div class="hero hero--capa"></div>
  <div class="scrim"></div>
  <span class="aspas aspas--abre">&ldquo;</span>
  <span class="aspas aspas--fecha">&rdquo;</span>
  <div class="body">
    <h1 class="declaracao">Você merece<br/>uma identidade<br/>que não some<br/>da cabeça de quem<br/><span class="accent">deveria comprar</span>.</h1>
    <p class="sub">Eu monto a marca pra você aparecer de verdade.</p>
  </div>
  <div class="foot"><span>@liaestudiocuritiba</span><span class="swipe">Arraste &rarr;</span></div>
</div>

</body>
</html>

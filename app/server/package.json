{
  "name": "server",
  "version": "1.4.0",
  "private": true,
  "description": "Backend local do VKOS Hub. Fastify, WebSocket e orquestracao multi-IA.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/index.ts",
    "checar": "tsc --noEmit -p tsconfig.json",
    "testar": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^8.0.0",
    "@fastify/websocket": "^11.0.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "archiver": "^7.0.0",
    "fastify": "^5.0.0",
    "node-html-parser": "6.1.13",
    "playwright-core": "^1.61.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}

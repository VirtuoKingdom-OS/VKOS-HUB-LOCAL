CORE_DOMAIN=core.exemplo.com
APP_DOMAIN=app.exemplo.com
# Segredo que libera o cadastro do primeiro operador do CORE. Sem ele, o cadastro
# fica desligado. Defina um valor longo e secreto antes do primeiro acesso e apague
# depois de criar o dono, se quiser. Sem esse valor, ninguem cria operador pela web.
OPERADOR_BOOTSTRAP_SEGREDO=troque-por-um-segredo-longo-e-unico
